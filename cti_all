-- [ CLOUD DATABASE LOADER ]
local rawUrl = "https://raw.githubusercontent.com/RiboKe/RiBoke_Egg_Farm_Tycoon/refs/heads/main/database_cti_all"
local CONFIG_URL = rawUrl .. "?t=" .. tostring(math.random(1, 1000000))

local CoreGui = game:GetService("CoreGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local success, EGG_DATABASE = pcall(function() return loadstring(game:HttpGet(CONFIG_URL))() end)
if not success then EGG_DATABASE = {["Error"] = {AllPets = {}, EggName = "None"}} end

-- [ ПЕРЕМЕННЫЕ ]
local settings = { waitTime = 0.5, selectedEgg = next(EGG_DATABASE), deleteList = {} }
local isActive, isDestroyed, attempts = false, false, 0
local fileName = "cti_v5_final.json"

-- [ ЗАГРУЗКА ]
if isfile and isfile(fileName) then
    pcall(function() 
        local d = HttpService:JSONDecode(readfile(fileName))
        settings.waitTime = d.waitTime or 0.5
        settings.selectedEgg = d.selectedEgg or settings.selectedEgg
        settings.deleteList = d.deleteList or {}
    end)
end
local function save() if writefile then writefile(fileName, HttpService:JSONEncode(settings)) end end

-- [ ИНТЕРФЕЙС ]
local screenGui = Instance.new("ScreenGui", (RunService:IsStudio() and game.Players.LocalPlayer.PlayerGui) or CoreGui)
local main = Instance.new("Frame", screenGui)
main.Size, main.Position = UDim2.new(0, 250, 0, 350), UDim2.new(0.5, -125, 0.5, -175)
main.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
main.Active, main.Draggable = true, true
Instance.new("UICorner").Parent = main

local title = Instance.new("TextLabel", main)
title.Size, title.Position = UDim2.new(1, 0, 0, 30), UDim2.new(0, 0, 0, 5)
title.Text, title.TextColor3, title.BackgroundTransparency = "PS99 ULTRA MANAGER", Color3.new(0, 1, 0.6), 1
title.Font = Enum.Font.GothamBold

-- ВЫБОР ЯЙЦА
local dropBtn = Instance.new("TextButton", main)
dropBtn.Size, dropBtn.Position = UDim2.new(0.9, 0, 0, 30), UDim2.new(0.05, 0, 0.12, 0)
dropBtn.Text = settings.selectedEgg .. " ▼"
dropBtn.BackgroundColor3, dropBtn.TextColor3 = Color3.fromRGB(40, 40, 40), Color3.new(1, 1, 0)
Instance.new("UICorner").Parent = dropBtn

-- СПИСОК ПИТОМЦЕВ
local petListFrame = Instance.new("ScrollingFrame", main)
petListFrame.Size, petListFrame.Position = UDim2.new(0.9, 0, 0, 140), UDim2.new(0.05, 0, 0.25, 0)
petListFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
petListFrame.BorderSizePixel = 0
petListFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
petListFrame.ScrollBarThickness = 4
local listLayout = Instance.new("UIListLayout", petListFrame)
listLayout.VerticalAlignment = Enum.VerticalAlignment.Top

local function updatePetUI()
    for _, v in pairs(petListFrame:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
    local eggData = EGG_DATABASE[settings.selectedEgg]
    if not eggData or not eggData.AllPets then return end
    for _, petName in pairs(eggData.AllPets) do
        local isDel = table.find(settings.deleteList, petName)
        local btn = Instance.new("TextButton", petListFrame)
        btn.Size = UDim2.new(1, -5, 0, 28)
        btn.BackgroundColor3 = isDel and Color3.fromRGB(150, 50, 50) or Color3.fromRGB(45, 45, 45)
        btn.Text = (isDel and "[DELETE] " or "[KEEP] ") .. petName
        btn.TextColor3, btn.Font, btn.TextSize = Color3.new(1, 1, 1), Enum.Font.Gotham, 11
        btn.MouseButton1Click:Connect(function()
            local idx = table.find(settings.deleteList, petName)
            if idx then table.remove(settings.deleteList, idx) else table.insert(settings.deleteList, petName) end
            save(); updatePetUI()
        end)
    end
end

-- ВЫПАДАЮЩЕЕ МЕНЮ ЯИЦ
local eggScroll = Instance.new("ScrollingFrame", main)
eggScroll.Size, eggScroll.Position = UDim2.new(0.9, 0, 0, 0), UDim2.new(0.05, 0, 0.22, 0)
eggScroll.Visible, eggScroll.ZIndex, eggScroll.BackgroundColor3 = false, 50, Color3.fromRGB(25, 25, 25)
Instance.new("UIListLayout", eggScroll)

for id, _ in pairs(EGG_DATABASE) do
    local b = Instance.new("TextButton", eggScroll)
    b.Size, b.Text = UDim2.new(1, 0, 0, 30), id
    b.TextColor3, b.BackgroundColor3, b.ZIndex = Color3.new(1, 1, 1), Color3.fromRGB(35, 35, 35), 51
    b.MouseButton1Click:Connect(function()
        settings.selectedEgg = id
        dropBtn.Text = id .. " ▼"
        eggScroll.Visible, eggScroll.Size = false, UDim2.new(0.9, 0, 0, 0)
        save(); updatePetUI()
    end)
end
eggScroll.CanvasSize = UDim2.new(0, 0, 0, #eggScroll:GetChildren()*30)
dropBtn.MouseButton1Click:Connect(function()
    eggScroll.Visible = not eggScroll.Visible
    eggScroll.Size = eggScroll.Visible and UDim2.new(0.9, 0, 0, 180) or UDim2.new(0.9, 0, 0, 0)
end)

-- ПАНЕЛЬ УПРАВЛЕНИЯ
local startB = Instance.new("TextButton", main)
startB.Size, startB.Position = UDim2.new(0.43, 0, 0, 35), UDim2.new(0.05, 0, 0.72, 0)
startB.Text, startB.BackgroundColor3 = "START", Color3.fromRGB(180, 50, 50)
startB.Font, startB.TextColor3 = Enum.Font.GothamBold, Color3.new(1, 1, 1)
Instance.new("UICorner").Parent = startB

local speedI = Instance.new("TextBox", main)
speedI.Size, speedI.Position = UDim2.new(0.43, 0, 0, 35), UDim2.new(0.52, 0, 0.72, 0)
speedI.Text, speedI.BackgroundColor3 = tostring(settings.waitTime), Color3.fromRGB(40, 40, 40)
speedI.TextColor3, speedI.Font = Color3.new(1, 1, 1), Enum.Font.Code
Instance.new("UICorner").Parent = speedI

local unloadB = Instance.new("TextButton", main)
unloadB.Size, unloadB.Position = UDim2.new(0.9, 0, 0, 30), UDim2.new(0.05, 0, 0.86, 0)
unloadB.Text, unloadB.BackgroundColor3 = "UNLOAD SCRIPT", Color3.fromRGB(60, 60, 60)
unloadB.TextColor3, unloadB.Font = Color3.new(0.7, 0.7, 0.7), Enum.Font.Gotham
Instance.new("UICorner").Parent = unloadB

-- ЛОГИКА
startB.MouseButton1Click:Connect(function()
    isActive = not isActive
    startB.Text = isActive and "STOP" or "START"
    startB.BackgroundColor3 = isActive and Color3.fromRGB(50, 180, 50) or Color3.fromRGB(180, 50, 50)
end)

speedI.FocusLost:Connect(function() settings.waitTime = tonumber(speedI.Text) or 0.5 save() end)
unloadB.MouseButton1Click:Connect(function() isDestroyed = true; screenGui:Destroy() end)

-- ЦИКЛ
task.spawn(function()
    local remote = ReplicatedStorage:WaitForChild("Events"):WaitForChild("InvokeServerAction")
    while not isDestroyed do
        if isActive then
            pcall(function()
                remote:InvokeServer("Eggs", "RequestPurchase", {
                    PetsToAutoDelete = settings.deleteList,
                    EggAmount = "max",
                    EggName = settings.selectedEgg
                })
            end)
            attempts = attempts + 1
            title.Text = "Attempts: " .. attempts
        end
        task.wait(settings.waitTime)
    end
end)

updatePetUI()
