-- === PATH BUILDER V0.22 ===
local PathBuilder = {}
PathBuilder.VERSION = "0.22"

PathBuilder.Character = nil
PathBuilder.Memory = nil

local RAY_DOWN_DIST = 50
local MAX_WALK_DIST = 12
local MAX_JUMP_DIST = 22
local MAX_JUMP_HEIGHT = 18
local MIN_PLATFORM_SIZE = 1
local WALK_POINT_SPACING = 4

local FailedDirections = {}
local FAILED_DIR_TIMEOUT = 30

-- === ПЛАТФОРМЫ ===
local function isValidPlatform(part)
    if not part or not part:IsA("BasePart") then return false end
    if not part.CanCollide then return false end
    if part.Transparency >= 1 then return false end
    if part.Size.X < MIN_PLATFORM_SIZE and part.Size.Z < MIN_PLATFORM_SIZE then return false end

    if PathBuilder.Memory and PathBuilder.Memory.IsPartDangerous then
        if PathBuilder.Memory.IsPartDangerous(part.Name) then
            return false
        end
    end

    return true
end

local function getSurfaceY(pos, character)
    local ray = Ray.new(pos + Vector3.new(0, 5, 0), Vector3.new(0, -RAY_DOWN_DIST, 0))
    local hit, hitPos = workspace:FindPartOnRay(ray, character)

    if hit and isValidPlatform(hit) then
        return hitPos.Y, hit
    end
    return nil, nil
end

local function isPositionSafe(pos, character)
    if PathBuilder.Memory and PathBuilder.Memory.IsPositionDangerous then
        local dangerous, partName = PathBuilder.Memory.IsPositionDangerous(pos)
        if dangerous then
            return false, nil
        end
    end

    local y, platform = getSurfaceY(pos, character)
    if not y then return false, nil end

    return true, platform
end

-- === СКАНИРОВАНИЕ ===
local function scanPlatformsAround(centerPos, radius, targetPos, character)
    local platforms = {}
    local stepSize = 3

    for angle = 0, 360, 15 do
        for dist = stepSize, radius, stepSize do
            local rad = math.rad(angle)
            local checkPos = centerPos + Vector3.new(
                math.cos(rad) * dist,
                0,
                math.sin(rad) * dist
            )

            local safe, platform = isPositionSafe(checkPos, character)
            if safe and platform then
                local surfaceY = getSurfaceY(checkPos, character)
                if surfaceY then
                    local platformPos = Vector3.new(checkPos.X, surfaceY + 3, checkPos.Z)
                    local distToTarget = (platformPos - targetPos).Magnitude
                    local dirToPlat = (platformPos - centerPos).Unit
                    local isFailedDir = false

                    for _, fd in ipairs(FailedDirections) do
                        if tick() - (fd.time or 0) < FAILED_DIR_TIMEOUT then
                            if fd.direction then
                                local dot = dirToPlat:Dot(fd.direction)
                                if dot > 0.8 then
                                    isFailedDir = true
                                    break
                                end
                            end
                        end
                    end

                    if not isFailedDir then
                        table.insert(platforms, {
                            position = platformPos,
                            platform = platform,
                            distToTarget = distToTarget,
                            distFromMe = dist
                        })
                    end
                end
            end
        end
    end

    table.sort(platforms, function(a, b)
        return a.distToTarget < b.distToTarget
    end)

    return platforms
end

-- === ТИП ПЕРЕМЕЩЕНИЯ ===
local function getMovementType(fromPos, toPos, character)
    local horizontalDist = ((toPos - fromPos) * Vector3.new(1, 0, 1)).Magnitude
    local verticalDiff = toPos.Y - fromPos.Y

    if horizontalDist < MAX_WALK_DIST and math.abs(verticalDiff) < 3 then
        local direction = toPos - fromPos
        if direction.Magnitude > 0.1 then
            local ray = Ray.new(fromPos, direction.Unit * horizontalDist)
            local hit = workspace:FindPartOnRay(ray, character)

            if not hit then
                return "walk"
            end
            if hit and hit.CanCollide then
                -- Проверяем не слишком ли высоко перекрытие
                if hit.Position.Y <= fromPos.Y + 3 then
                    return "walk"
                end
            end
        end
    end

    if horizontalDist < MAX_JUMP_DIST and verticalDiff < MAX_JUMP_HEIGHT and verticalDiff > -MAX_JUMP_HEIGHT then
        return "jump"
    end

    return "impossible"
end

-- === ПОСТРОЕНИЕ ПУТИ ===
function PathBuilder.BuildPath(startPos, targetPos, aggressive)
    local path = {}
    local currentPos = startPos
    local visited = {}
    local maxSteps = 50
    local character = PathBuilder.Character

    for step = 1, maxSteps do
        local dist = (targetPos - currentPos).Magnitude

        if dist < 8 then
            table.insert(path, {position = targetPos, type = "goal"})
            return path
        end

        local scanRadius = aggressive and 25 or 20
        local platforms = scanPlatformsAround(currentPos, scanRadius, targetPos, character)

        if #platforms == 0 then
            print("[PathBuilder] Нет платформ на шаге " .. step)
            return path
        end

        local bestPlatform = nil

        for _, plat in ipairs(platforms) do
            local key = PathBuilder.Memory and PathBuilder.Memory.Vec3ToKey and PathBuilder.Memory.Vec3ToKey(plat.position) or tostring(plat.position)

            if not visited[key] then
                local moveType = getMovementType(currentPos, plat.position, character)

                if moveType ~= "impossible" then
                    bestPlatform = plat
                    bestPlatform.moveType = moveType
                    break
                end
            end
        end

        if not bestPlatform then
            for _, plat in ipairs(platforms) do
                local key = PathBuilder.Memory and PathBuilder.Memory.Vec3ToKey and PathBuilder.Memory.Vec3ToKey(plat.position) or tostring(plat.position)

                if not visited[key] then
                    bestPlatform = plat
                    bestPlatform.moveType = "jump"
                    break
                end
            end
        end

        if not bestPlatform then
            print("[PathBuilder] Все платформы посещены")
            return path
        end

        local visitKey = PathBuilder.Memory and PathBuilder.Memory.Vec3ToKey and PathBuilder.Memory.Vec3ToKey(bestPlatform.position) or tostring(bestPlatform.position)
        visited[visitKey] = true

        if bestPlatform.moveType == "jump" then
            table.insert(path, {position = currentPos, type = "jump_start"})
            table.insert(path, {position = bestPlatform.position, type = "jump_land"})
        else
            table.insert(path, {position = bestPlatform.position, type = "walk"})
        end

        currentPos = bestPlatform.position
    end

    return path
end

function PathBuilder.BuildAlternativePath(startPos, targetPos)
    local dirToTarget = (targetPos - startPos).Unit
    PathBuilder.AddFailedDirection(startPos, dirToTarget)

    -- Добавляем ещё случайных блокировок
    for i = 1, 3 do
        local angle = math.random() * math.pi * 2
        local randomDir = Vector3.new(math.cos(angle), 0, math.sin(angle))
        PathBuilder.AddFailedDirection(startPos, randomDir)
    end

    local path = PathBuilder.BuildPath(startPos, targetPos, true)
    return path
end

function PathBuilder.AddFailedDirection(fromPos, direction)
    if not fromPos or not direction then return end
    table.insert(FailedDirections, {
        position = fromPos,
        direction = direction,
        time = tick()
    })

    local newList = {}
    for _, fd in ipairs(FailedDirections) do
        if tick() - (fd.time or 0) < FAILED_DIR_TIMEOUT then
            table.insert(newList, fd)
        end
    end
    FailedDirections = newList
end

function PathBuilder.ResetFailedDirections()
    FailedDirections = {}
end

return PathBuilder
