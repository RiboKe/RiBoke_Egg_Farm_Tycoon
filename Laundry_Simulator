local serv = win:Server("GUI", "")
local auf = serv:Channel("Farm")

-- Функция для автоматического сбора одежды
local function AutoGrabClothing()
    spawn(function()
        while getgenv().agc do
            for _, v in pairs(game:GetService("Workspace").Debris.Clothing:GetChildren()) do
                if v:IsA("MeshPart") then
                    local Event = game:GetService("ReplicatedStorage").Events.GrabClothing
                    Event:FireServer(v)
                    wait(0.1) -- Задержка, чтобы не перегружать сервер
                end
            end
        end
    end)
end

-- Функция для автоматической загрузки стиральной машины
local function AutoLoadWashingMachine()
    spawn(function()
        while getgenv().alwm do
            local plot = Owner()
            if plot then
                for _, v in pairs(plot.WashingMachines:GetChildren()) do
                    if v:IsA("Model") then
                        local Event = game:GetService("ReplicatedStorage").Events.LoadWashingMachine
                        Event:FireServer(v)
                        wait(0.5) -- Задержка, чтобы не перегружать сервер
                    end
                end
            end
        end
    end)
end

-- Функция для автоматической выгрузки стиральной машины
local function AutoUnloadWashingMachine()
    spawn(function()
        while getgenv().auwm do
            local plot = Owner()
            if plot then
                for _, v in pairs(plot.WashingMachines:GetChildren()) do
                    if v:IsA("Model") then
                        local Event = game:GetService("ReplicatedStorage").Events.UnloadWashingMachine
                        Event:FireServer(v)
                        wait(0.5) -- Задержка, чтобы не перегружать сервер
                    end
                end
            end
        end
    end)
end

-- Функция для автоматического выбрасывания одежды в шахту
local function AutoDropClothesInChute()
    spawn(function()
        while getgenv().adc do
            local Event = game:GetService("ReplicatedStorage").Events.DropClothesInChute
            Event:FireServer()
            wait(0.1) -- Задержка между запросами
        end
    end)
end

