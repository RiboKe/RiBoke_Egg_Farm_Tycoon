-- === ОСНОВНОЙ ЦИКЛ ===
local function startBot()
    if not targetPosition then
        log("❌ Сначала выбери цель!")
        isActive = false
        btnToggle.Text = "▶ СТАРТ"
        btnToggle.BackgroundColor3 = Color3.fromRGB(50, 150, 80)
        return
    end
    
    local attempts = 0
    local maxAttempts = 30
    
    while isActive and not isUnloaded and attempts < maxAttempts do
        if not character or not rootPart or not humanoid or humanoid.Health <= 0 then
            log("⏳ Ожидаю респавн...")
            task.wait(1)
            character = player.Character
            if character then
                humanoid = character:FindFirstChild("Humanoid")
                rootPart = character:FindFirstChild("HumanoidRootPart")
                
                -- Обновляем ссылки в модулях
                PathBuilder.Character = character
                Movement.Humanoid = humanoid
                Movement.RootPart = rootPart
                Movement.Character = character
            end
            continue
        end
        
        local dist = (targetPosition - rootPart.Position).Magnitude
        if dist < 5 then
            log("🎉 ЦЕЛЬ ДОСТИГНУТА!")
            clearVisuals()
            isActive = false
            btnToggle.Text = "▶ СТАРТ"
            btnToggle.BackgroundColor3 = Color3.fromRGB(50, 150, 80)
            return
        end
        
        log("🔍 Сканирую путь...")
        currentPath = PathBuilder.BuildPath(rootPart.Position, targetPosition)
        
        if #currentPath == 0 then
            log("❌ Путь не найден!")
            attempts = attempts + 1
            
            if Movement.IsOnGround() then
                local dir = (targetPosition - rootPart.Position).Unit
                humanoid:MoveTo(rootPart.Position + dir * 8)
                task.wait(0.15)
                Movement.DoJump()
                task.wait(0.6)
            end
            continue
        end
        
        log(string.format("✓ Путь: %d точек", #currentPath))
        visualizePath(currentPath)
        
        local success = Movement.ExecutePath(currentPath, function(i, total)
            currentPathIndex = i
            highlightCurrent(i)
            updateStats()
        end)
        
        if success then
            attempts = 0
        else
            attempts = attempts + 1
            log(string.format("🔄 Перестраиваю (%d/%d)", attempts, maxAttempts))
        end
        
        task.wait(0.3)
    end
    
    if attempts >= maxAttempts then
        log("😞 Не удалось достичь цели")
    end
    
    clearVisuals()
    isActive = false
    btnToggle.Text = "▶ СТАРТ"
    btnToggle.BackgroundColor3 = Color3.fromRGB(50, 150, 80)
end

