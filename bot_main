    if targetPosition and rootPart then
        dist = string.format("%.0fм", (targetPosition - rootPart.Position).Magnitude)
    end
    local memStats = Memory.GetStats()
    statsLabel.Text = string.format("Смертей: %d | Зон: %d | Kill: %d", 
