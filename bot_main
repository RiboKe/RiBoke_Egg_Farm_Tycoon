-- === ОБРАБОТКА СМЕРТИ ===
local function setupCharacter(char)
    character = char
    humanoid = char:WaitForChild("Humanoid")
    rootPart = char:WaitForChild("HumanoidRootPart")
    
    -- Обновляем модули
    PathBuilder.Character = character
    Movement.Humanoid = humanoid
    Movement.RootPart = rootPart
    Movement.Character = character
    
    local deathPos = nil
    local touchedParts = {}
    
    local touchConn = rootPart.Touched:Connect(function(part)
        if part and part:IsA("BasePart") then
            touchedParts[part] = tick()
        end
    end)
    
    local trackConn = RunService.Heartbeat:Connect(function()
        if humanoid and humanoid.Health > 0 and rootPart then
            deathPos = rootPart.Position
        end
    end)
    
    humanoid.Died:Connect(function()
        if trackConn then trackConn:Disconnect() end
        if touchConn then touchConn:Disconnect() end
        
        deathCount = deathCount + 1
        
        -- Находим kill-часть
        local recentTouch = nil
        local recentTime = 0
        for part, t in pairs(touchedParts) do
            if t > recentTime then 
                recentTime = t 
                recentTouch = part 
            end
        end
        
        local killPartName = nil
        if recentTouch then
            killPartName = recentTouch.Name
            Memory.RememberKillPart(killPartName)
        end
        
        -- Добавляем зону смерти
        if deathPos then
            local count, radius = Memory.AddDeathZone(deathPos, killPartName)
            log(string.format("💀 Смерть #%d | Зона: R=%d, x%d", deathCount, radius, count))
        end
        
        clearVisuals()
        updateStats()
    end)
end

