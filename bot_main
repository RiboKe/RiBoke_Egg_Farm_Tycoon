-- === ВИЗУАЛИЗАЦИЯ ===
local function clearVisuals()
    for _, v in ipairs(pathVisuals) do
        if v and v.Parent then v:Destroy() end
    end
    pathVisuals = {}
end

local function createPointMarker(pos, index, pointType)
    if not showPath then return end
    
    local marker = Instance.new("Part")
    marker.Name = "PathPoint_" .. index
    marker.Anchored = true
    marker.CanCollide = false
    marker.CastShadow = false
    marker.Material = Enum.Material.Neon
    
    if pointType == "jump_start" then
        marker.Shape = Enum.PartType.Cylinder
        marker.Size = Vector3.new(0.5, 1.5, 1.5)
        marker.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
        marker.BrickColor = BrickColor.new("Bright orange")
    elseif pointType == "jump_land" then
        marker.Shape = Enum.PartType.Ball
        marker.Size = Vector3.new(1.2, 1.2, 1.2)
        marker.BrickColor = BrickColor.new("Cyan")
    else
        marker.Shape = Enum.PartType.Block
        marker.Size = Vector3.new(0.8, 0.3, 0.8)
        marker.BrickColor = BrickColor.new("White")
        marker.Transparency = 0.3
    end
    
    marker.Position = pos
    marker.Parent = workspace
    
    local bb = Instance.new("BillboardGui", marker)
    bb.Size = UDim2.new(0, 40, 0, 25)
    bb.StudsOffset = Vector3.new(0, 1.5, 0)
    bb.AlwaysOnTop = true
    
    local lbl = Instance.new("TextLabel", bb)
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.Text = index .. (pointType == "jump_start" and "⬆" or pointType == "jump_land" and "⬇" or "")
    lbl.TextColor3 = marker.BrickColor.Color
    lbl.TextStrokeTransparency = 0
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 12
    
    table.insert(pathVisuals, marker)
end

local function createLine(from, to, lineType)
    if not showPath then return end
    
    local dist = (to - from).Magnitude
    if dist < 0.3 then return end
    
    local line = Instance.new("Part")
    line.Name = "PathLine"
    line.Size = Vector3.new(0.15, 0.15, dist)
    line.Material = Enum.Material.Neon
    line.Anchored = true
    line.CanCollide = false
    line.CastShadow = false
    
    if lineType == "jump" then
        line.BrickColor = BrickColor.new("Bright orange")
    else
        line.BrickColor = BrickColor.new("White")
        line.Transparency = 0.5
    end
    
    line.CFrame = CFrame.lookAt(from, to) * CFrame.new(0, 0, -dist/2)
    line.Parent = workspace
    
    table.insert(pathVisuals, line)
end

local function visualizePath(path)
    clearVisuals()
    if not showPath or #path == 0 then return end
    
    for i, node in ipairs(path) do
        createPointMarker(node.position, i, node.type)
        
        if i < #path then
            local nextNode = path[i + 1]
            local lineType = node.type == "jump_start" and "jump" or "walk"
            createLine(node.position, nextNode.position, lineType)
        end
    end
end

local function highlightCurrent(index)
    for _, v in ipairs(pathVisuals) do
        if v and v.Name:match("PathPoint_") then
            local idx = tonumber(v.Name:match("PathPoint_(%d+)"))
            if idx then
                if idx < index then
                    v.Transparency = 0.8
                    if v.Size.Magnitude > 1 then
                        v.Size = v.Size * 0.5
                    end
                elseif idx == index then
                    v.BrickColor = BrickColor.new("Lime green")
                    v.Transparency = 0
                end
            end
        end
    end
end

