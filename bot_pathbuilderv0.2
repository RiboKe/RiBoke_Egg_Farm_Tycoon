-- === PATH BUILDER V0.2 - FIXED JUMP OVER KILL ZONES ===
local PathBuilder = {}
PathBuilder.VERSION = "0.2"

PathBuilder.Character = nil
PathBuilder.Memory = nil

local RAY_DOWN_DIST = 50
local MAX_WALK_DIST = 10
local MAX_JUMP_DIST = 20
local MAX_JUMP_HEIGHT = 18
local MIN_PLATFORM_SIZE = 1
local WALK_POINT_SPACING = 4

-- Константы для kill-зон
local KILL_ZONE_CHECK_STEP = 1.5  -- Шаг проверки kill-блоков (чаще = точнее)
local APPROACH_DISTANCE = 3       -- Расстояние подхода к прыжку

local FailedDirections = {}
local FAILED_DIR_TIMEOUT = 30

-- === ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ===

local function isValidPlatform(part)
    if not part or not part:IsA("BasePart") then return false end
    if not part.CanCollide then return false end
    if part.Transparency >= 1 then return false end
    if part.Size.X < MIN_PLATFORM_SIZE and part.Size.Z < MIN_PLATFORM_SIZE then return false end
    return true
end

local function isKillPart(part)
    if not part then return false end
    if PathBuilder.Memory and PathBuilder.Memory.IsPartDangerous then
        return PathBuilder.Memory.IsPartDangerous(part.Name)
    end
    return false
end

local function getRayParams(character)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {character}
    return raycastParams
end

local function getSurfaceY(pos, character)
    local rayOrigin = pos + Vector3.new(0, 5, 0)
    local rayDirection = Vector3.new(0, -RAY_DOWN_DIST, 0)
    local raycastParams = getRayParams(character)
    
    local result = workspace:Raycast(rayOrigin, rayDirection, raycastParams)
    
    if result and result.Instance then
        if isValidPlatform(result.Instance) then
            return result.Position.Y, result.Instance, false
        elseif isKillPart(result.Instance) then
            return result.Position.Y, result.Instance, true
        end
    end
    return nil, nil, false
end

-- === КЛЮЧЕВАЯ ФУНКЦИЯ: Проверка kill-блоков между точками ===
local function findKillBlocksBetween(fromPos, toPos, character)
    local direction = toPos - fromPos
    local distance = direction.Magnitude
    if distance < 1 then return false, nil, nil end
    
    local dirUnit = direction.Unit
    local steps = math.ceil(distance / KILL_ZONE_CHECK_STEP)
    local raycastParams = getRayParams(character)
    
    local killBlocks = {}
    local firstKillPos = nil
    local lastKillPos = nil
    
    for i = 1, steps do
        local t = i / steps
        local checkPos = fromPos:Lerp(toPos, t)
        
        -- Рейкаст вниз
        local rayOrigin = Vector3.new(checkPos.X, math.max(fromPos.Y, toPos.Y) + 5, checkPos.Z)
        local result = workspace:Raycast(rayOrigin, Vector3.new(0, -15, 0), raycastParams)
        
        if result and result.Instance and isKillPart(result.Instance) then
            if not firstKillPos then
                firstKillPos = result.Position
            end
            lastKillPos = result.Position
            killBlocks[result.Instance] = true
        end
        
        -- Горизонтальный рейкаст
        if i < steps then
            local nextPos = fromPos:Lerp(toPos, (i + 1) / steps)
            local horizDir = (nextPos - checkPos)
            if horizDir.Magnitude > 0.1 then
                local horizResult = workspace:Raycast(
                    checkPos + Vector3.new(0, 1, 0),
                    horizDir,
                    raycastParams
                )
                if horizResult and horizResult.Instance and isKillPart(horizResult.Instance) then
                    if not firstKillPos then
                        firstKillPos = horizResult.Position
                    end
                    lastKillPos = horizResult.Position
                    killBlocks[horizResult.Instance] = true
                end
            end
        end
    end
    
    local count = 0
    for _ in pairs(killBlocks) do count = count + 1 end
    
    return count > 0, firstKillPos, lastKillPos
end

-- === ПРОВЕРКИ БЕЗОПАСНОСТИ ===

-- Безопасность для ходьбы (строгая)
local function isPositionSafeForWalk(pos, character)
    if PathBuilder.Memory then
        if PathBuilder.Memory.IsPositionDangerousForWalk then
            if PathBuilder.Memory.IsPositionDangerousForWalk(pos) then
                return false, nil
            end
        elseif PathBuilder.Memory.IsPositionDangerous then
            if PathBuilder.Memory.IsPositionDangerous(pos) then
                return false, nil
            end
        end
    end

    local y, platform, isKill = getSurfaceY(pos, character)
    if not y or isKill then return false, nil end

    return true, platform
end

-- Безопасность для приземления (мягкая - только сама точка)
local function isLandingSafe(pos, character)
    local y, platform, isKill = getSurfaceY(pos, character)
    if not y then return false, nil end
    if isKill then return false, nil end
    
    -- Проверяем что это не kill-точка в памяти
    if PathBuilder.Memory and PathBuilder.Memory.IsLandingPositionSafe then
        if not PathBuilder.Memory.IsLandingPositionSafe(pos) then
            return false, nil
        end
    end

    return true, platform
end

-- === СКАНИРОВАНИЕ ПЛАТФОРМ ===
local function scanPlatformsAround(centerPos, radius, targetPos, character, forJump)
    local platforms = {}
    local stepSize = 3
    local angleStep = 20

    for angle = 0, 360, angleStep do
        for dist = stepSize, radius, stepSize do
            local rad = math.rad(angle)
            local checkPos = centerPos + Vector3.new(
                math.cos(rad) * dist,
                0,
                math.sin(rad) * dist
            )

            local safe, platform
            if forJump then
                safe, platform = isLandingSafe(checkPos, character)
            else
                safe, platform = isPositionSafeForWalk(checkPos, character)
            end
            
            if safe and platform then
                local surfaceY, _, isKill = getSurfaceY(checkPos, character)
                if surfaceY and not isKill then
                    local platformPos = Vector3.new(checkPos.X, surfaceY + 3, checkPos.Z)
                    local distToTarget = (platformPos - targetPos).Magnitude
                    local dirToPlat = (platformPos - centerPos)
                    if dirToPlat.Magnitude > 0.1 then
                        dirToPlat = dirToPlat.Unit
                    else
                        dirToPlat = Vector3.new(0, 0, 1)
                    end
                    
                    -- Проверяем failed directions
                    local isFailedDir = false
                    for _, fd in ipairs(FailedDirections) do
                        if tick() - (fd.time or 0) < FAILED_DIR_TIMEOUT then
                            if fd.direction and dirToPlat:Dot(fd.direction) > 0.85 then
                                isFailedDir = true
                                break
                            end
                        end
                    end

                    if not isFailedDir then
                        -- Проверяем kill-блоки между позициями
                        local hasKill, firstKill, lastKill = findKillBlocksBetween(centerPos, platformPos, character)
                        
                        table.insert(platforms, {
                            position = platformPos,
                            platform = platform,
                            distToTarget = distToTarget,
                            distFromMe = dist,
                            hasKillBetween = hasKill,
                            firstKillPos = firstKill,
                            lastKillPos = lastKill,
                            heightDiff = platformPos.Y - centerPos.Y
                        })
                    end
                end
            end
        end
    end

    -- Сортировка: приоритет платформам ближе к цели
    table.sort(platforms, function(a, b)
        -- Бонус за платформы ЗА kill-блоком (они требуют прыжка, но ведут вперёд)
        local scoreA = a.distToTarget
        local scoreB = b.distToTarget
        
        if a.hasKillBetween and a.distToTarget < (targetPos - centerPos).Magnitude then
            scoreA = scoreA - 5  -- Бонус за прыжок через kill в сторону цели
        end
        if b.hasKillBetween and b.distToTarget < (targetPos - centerPos).Magnitude then
            scoreB = scoreB - 5
        end
        
        return scoreA < scoreB
    end)

    return platforms
end

-- === ОПРЕДЕЛЕНИЕ ТИПА ДВИЖЕНИЯ ===
local function getMovementType(fromPos, toPos, character, platformData)
    local horizontalDist = ((toPos - fromPos) * Vector3.new(1, 0, 1)).Magnitude
    local verticalDiff = toPos.Y - fromPos.Y
    
    -- ПРИОРИТЕТ 1: Если между точками есть kill-блок — ОБЯЗАТЕЛЬНО прыжок
    if platformData and platformData.hasKillBetween then
        return "jump", "kill_block_between"
    end
    
    -- Проверяем kill-блоки напрямую если нет platformData
    local hasKill = findKillBlocksBetween(fromPos, toPos, character)
    if hasKill then
        return "jump", "kill_block_detected"
    end
    
    -- ПРИОРИТЕТ 2: Нужно подняться — прыжок
    if verticalDiff > 2.5 then
        return "jump", "height_difference"
    end
    
    -- ПРИОРИТЕТ 3: Большое расстояние
    if horizontalDist > MAX_WALK_DIST then
        return "jump", "distance"
    end
    
    -- ПРИОРИТЕТ 4: Проверка препятствий
    local raycastParams = getRayParams(character)
    local direction = (toPos - fromPos)
    if direction.Magnitude > 0.1 then
        direction = direction.Unit
    end
    
    local ray = workspace:Raycast(
        fromPos + Vector3.new(0, 1.5, 0),
        direction * horizontalDist,
        raycastParams
    )
    
    if ray and ray.Instance then
        local hitDist = (ray.Position - fromPos).Magnitude
        if hitDist < horizontalDist - 1 then
            return "jump", "obstacle"
        end
    end
    
    return "walk", "clear_path"
end

-- === ПОСТРОЕНИЕ ПУТИ ===
function PathBuilder.BuildPath(startPos, targetPos, aggressive)
    local character = PathBuilder.Character
    if not character then return {} end
    
    local path = {}
    local currentPos = startPos
    local maxIterations = 30
    local visited = {}
    
    for iter = 1, maxIterations do
        local distToTarget = (targetPos - currentPos).Magnitude
        
        -- Достигли цели
        if distToTarget < 5 then
            table.insert(path, {
                position = targetPos,
                type = "target"
            })
            break
        end
        
        -- Защита от зацикливания
        local posKey = string.format("%.0f_%.0f_%.0f", currentPos.X, currentPos.Y, currentPos.Z)
        if visited[posKey] then
            break
        end
        visited[posKey] = true
        
        -- Сканируем платформы (включая те, до которых надо прыгать)
        local platforms = scanPlatformsAround(currentPos, MAX_JUMP_DIST, targetPos, character, true)
        
        if #platforms == 0 then
            -- Нет платформ — пробуем идти напрямую
            local directPos = currentPos + (targetPos - currentPos).Unit * WALK_POINT_SPACING
            local safe, _ = isPositionSafeForWalk(directPos, character)
            if safe then
                table.insert(path, {
                    position = directPos,
                    type = "walk"
                })
                currentPos = directPos
            else
                break
            end
        else
            -- Выбираем лучшую платформу
            local bestPlatform = nil
            
            for _, plat in ipairs(platforms) do
                -- Пропускаем платформы дальше от цели чем мы сейчас (кроме aggressive режима)
                if aggressive or plat.distToTarget < distToTarget + 3 then
                    bestPlatform = plat
                    break
                end
            end
            
            if not bestPlatform then
                bestPlatform = platforms[1]  -- Fallback на ближайшую к цели
            end
            
            if not bestPlatform then
                break
            end
            
            local moveType, reason = getMovementType(currentPos, bestPlatform.position, character, bestPlatform)
            
            if moveType == "jump" then
                -- === ПРЫЖОК ===
                
                -- Точка старта прыжка (немного перед kill-зоной или текущая позиция)
                local jumpStartPos = currentPos
                
                if bestPlatform.hasKillBetween and bestPlatform.firstKillPos then
                    -- Подходим к краю перед kill-блоком
                    local dirToKill = (bestPlatform.firstKillPos - currentPos)
                    local horizDir = Vector3.new(dirToKill.X, 0, dirToKill.Z)
                    if horizDir.Magnitude > APPROACH_DISTANCE then
                        jumpStartPos = currentPos + horizDir.Unit * (horizDir.Magnitude - APPROACH_DISTANCE)
                        
                        -- Добавляем точку подхода если она далеко
                        if (jumpStartPos - currentPos).Magnitude > 2 then
                            table.insert(path, {
                                position = jumpStartPos,
                                type = "walk"
                            })
                        end
                    end
                end
                
                -- Добавляем точку старта прыжка
                table.insert(path, {
                    position = jumpStartPos,
                    type = "jump_start",
                    jumpReason = reason,
                    hasKillBetween = bestPlatform.hasKillBetween
                })
                
                -- Добавляем точку приземления
                table.insert(path, {
                    position = bestPlatform.position,
                    type = "jump_land",
                    hasKillBetween = bestPlatform.hasKillBetween
                })
                
                currentPos = bestPlatform.position
                
            else
                -- === ХОДЬБА ===
                
                -- Если далеко — добавляем промежуточные точки
                local dist = (bestPlatform.position - currentPos).Magnitude
                if dist > WALK_POINT_SPACING * 2 then
                    local steps = math.ceil(dist / WALK_POINT_SPACING)
                    for s = 1, steps - 1 do
                        local t = s / steps
                        local intermediatePos = currentPos:Lerp(bestPlatform.position, t)
                        
                        -- Проверяем безопасность промежуточной точки
                        local safe, _ = isPositionSafeForWalk(intermediatePos, character)
                        if safe then
                            table.insert(path, {
                                position = intermediatePos,
                                type = "walk"
                            })
                        end
                    end
                end
                
                table.insert(path, {
                    position = bestPlatform.position,
                    type = "walk"
                })
                
                currentPos = bestPlatform.position
            end
        end
        
        -- Лимит точек
        if #path >= 50 then
            break
        end
    end
    
    return path
end

-- === АЛЬТЕРНАТИВНЫЙ ПУТЬ ===
function PathBuilder.BuildAlternativePath(startPos, targetPos)
    -- Пробуем обойти с разных сторон
    local character = PathBuilder.Character
    if not character then return {} end
    
    local dirToTarget = (targetPos - startPos)
    local horizDir = Vector3.new(dirToTarget.X, 0, dirToTarget.Z)
    if horizDir.Magnitude < 0.1 then
        return PathBuilder.BuildPath(startPos, targetPos, true)
    end
    horizDir = horizDir.Unit
    
    -- Боковые направления
    local leftDir = Vector3.new(-horizDir.Z, 0, horizDir.X)
    local rightDir = Vector3.new(horizDir.Z, 0, -horizDir.X)
    
    local bestPath = {}
    local bestScore = math.huge
    
    for _, sideDir in ipairs({leftDir, rightDir}) do
        for sideDist = 5, 15, 5 do
            local sidePos = startPos + sideDir * sideDist
            local safe, _ = isPositionSafeForWalk(sidePos, character)
            
            if safe then
                -- Строим путь через боковую точку
                local pathToSide = PathBuilder.BuildPath(startPos, sidePos, false)
                local pathFromSide = PathBuilder.BuildPath(sidePos, targetPos, false)
                
                if #pathToSide > 0 and #pathFromSide > 0 then
                    local combinedPath = {}
                    for _, node in ipairs(pathToSide) do
                        table.insert(combinedPath, node)
                    end
                    for _, node in ipairs(pathFromSide) do
                        table.insert(combinedPath, node)
                    end
                    
                    local score = #combinedPath
                    if score < bestScore then
                        bestScore = score
                        bestPath = combinedPath
                    end
                end
            end
        end
    end
    
    if #bestPath > 0 then
        return bestPath
    end
    
    return PathBuilder.BuildPath(startPos, targetPos, true)
end

-- === FAILED DIRECTIONS ===
function PathBuilder.AddFailedDirection(position, direction)
    if not direction or direction.Magnitude < 0.1 then return end
    
    table.insert(FailedDirections, {
        position = position,
        direction = direction.Unit,
        time = tick()
    })
    
    -- Очистка старых
    local newList = {}
    for _, fd in ipairs(FailedDirections) do
        if tick() - (fd.time or 0) < FAILED_DIR_TIMEOUT then
            table.insert(newList, fd)
        end
    end
    FailedDirections = newList
end

function PathBuilder.ResetFailedDirections()
    FailedDirections = {}
end

-- === ЭКСПОРТ ДЛЯ ОТЛАДКИ ===
PathBuilder.FindKillBlocksBetween = findKillBlocksBetween
PathBuilder.IsPositionSafeForWalk = isPositionSafeForWalk
PathBuilder.IsLandingSafe = isLandingSafe

return PathBuilder
