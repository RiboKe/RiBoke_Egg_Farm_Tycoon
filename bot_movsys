-- === MOVEMENT MODULE v0.19 ===
local Movement = {}

Movement.VERSION = "0.19"
Movement.NAME = "Movement"

Movement.Humanoid = nil
Movement.RootPart = nil
Movement.Character = nil
Movement.Memory = nil
Movement.PathBuilder = nil
Movement.IsActive = function() return false end
Movement.Log = function(text) end

function Movement.IsOnGround()
    if not Movement.Humanoid then return false end
    local state = Movement.Humanoid:GetState()
    return state ~= Enum.HumanoidStateType.Jumping 
        and state ~= Enum.HumanoidStateType.Freefall
        and state ~= Enum.HumanoidStateType.Climbing
end

function Movement.DoJump()
    if not Movement.Humanoid then return false end
    
    Movement.Humanoid.Jump = true
    
    task.spawn(function()
        task.wait(0.02)
        if Movement.Humanoid then
            pcall(function()
                Movement.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end)
        end
    end)
    
    task.spawn(function()
        for i = 1, 5 do
            task.wait(0.05)
            if Movement.Humanoid and Movement.IsOnGround() then
                Movement.Humanoid.Jump = true
            end
        end
    end)
    
    return true
end

function Movement.ForceJump(targetPos)
    if not Movement.Humanoid or not Movement.RootPart then return false end
    
    local startY = Movement.RootPart.Position.Y
    local jumped = false
    
    if targetPos then
        Movement.Humanoid:MoveTo(targetPos)
    end
    
    for attempt = 1, 15 do
        if not Movement.IsActive() then return false end
        
        local currentY = Movement.RootPart.Position.Y
        local state = Movement.Humanoid:GetState()
        
        if state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall then
            jumped = true
            break
        end
        
        if currentY > startY + 1 then
            jumped = true
            break
        end
        
        Movement.Humanoid.Jump = true
        
        if attempt > 3 then
            pcall(function()
                Movement.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end)
        end
        
        if attempt > 6 then
            local backDir = -Movement.RootPart.CFrame.LookVector
            Movement.Humanoid:MoveTo(Movement.RootPart.Position + backDir * 2)
            task.wait(0.1)
            if targetPos then
                Movement.Humanoid:MoveTo(targetPos)
            end
            Movement.Humanoid.Jump = true
        end
        
        task.wait(0.05)
    end
    
    return jumped
end

function Movement.WaitForLanding(timeout)
    timeout = timeout or 3
    local startTime = tick()
    
    task.wait(0.2)
    
    while tick() - startTime < timeout do
        if Movement.IsOnGround() then
            return true
        end
        task.wait(0.05)
    end
    
    return Movement.IsOnGround()
end

-- Raycast утилиты
local function getRayParams()
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
    rayParams.FilterDescendantsInstances = {Movement.Character}
    return rayParams
end

local function checkWallAhead(position, direction, maxDist)
    if not Movement.Character then return nil end
    
    maxDist = maxDist or 3
    direction = Vector3.new(direction.X, 0, direction.Z)
    if direction.Magnitude < 0.1 then return nil end
    direction = direction.Unit
    
    local rayParams = getRayParams()
    
    for _, height in ipairs({0.3, 1.0, 2.0}) do
        local origin = position + Vector3.new(0, height, 0)
        local ray = workspace:Raycast(origin, direction * maxDist, rayParams)
        
        if ray and ray.Instance then
            local hitTop = ray.Instance.Position.Y + ray.Instance.Size.Y / 2
            local wallHeight = hitTop - position.Y
            
            if wallHeight > 0.5 then
                return {
                    position = ray.Position,
                    part = ray.Instance,
                    height = wallHeight,
                    distance = (ray.Position - position).Magnitude
                }
            end
        end
    end
    
    return nil
end

-- НОВОЕ: Проверка можно ли обойти стену сбоку
local function findWallBypass(position, wallDirection, targetPos)
    if not Movement.Character then return nil end
    
    local rayParams = getRayParams()
    
    -- Направления: лево и право от стены
    local leftDir = Vector3.new(-wallDirection.Z, 0, wallDirection.X).Unit
    local rightDir = Vector3.new(wallDirection.Z, 0, -wallDirection.X).Unit
    
    local bypassOptions = {}
    
    for _, sideData in ipairs({{dir = leftDir, name = "left"}, {dir = rightDir, name = "right"}}) do
        local sideDir = sideData.dir
        
        -- Проверяем на разных дистанциях сбоку
        for sideDist = 3, 12, 3 do
            local sidePos = position + sideDir * sideDist
            
            -- Проверяем есть ли пол сбоку
            local floorRay = workspace:Raycast(
                sidePos + Vector3.new(0, 5, 0), 
                Vector3.new(0, -15, 0), 
                rayParams
            )
            
            if floorRay then
                local floorPos = floorRay.Position + Vector3.new(0, 3, 0)
                
                -- Проверяем нет ли стены между нами и этой точкой
                local pathRay = workspace:Raycast(
                    position + Vector3.new(0, 1, 0),
                    (sidePos - position),
                    rayParams
                )
                
                local pathClear = not pathRay or (pathRay.Position - position).Magnitude > sideDist - 1
                
                if pathClear then
                    -- Проверяем можно ли оттуда идти к цели
                    local toTargetDir = (targetPos - floorPos)
                    local toTargetDist = toTargetDir.Magnitude
                    
                    if toTargetDist > 0.1 then
                        toTargetDir = toTargetDir.Unit
                        
                        -- Проверяем нет ли стены между боковой точкой и целью
                        local forwardWall = checkWallAhead(floorPos, toTargetDir, 5)
                        
                        -- Проверяем безопасность точки
                        local isDangerous = false
                        if Movement.Memory then
                            isDangerous = Movement.Memory.IsDeathZone(floorPos)
                        end
                        
                        if not isDangerous then
                            local score = 0
                            
                            -- Бонус если нет стены впереди
                            if not forwardWall then
                                score = score + 10
                            end
                            
                            -- Бонус за близость к цели
                            local distToTarget = (targetPos - floorPos).Magnitude
                            local currentDistToTarget = (targetPos - position).Magnitude
                            if distToTarget < currentDistToTarget then
                                score = score + 5
                            end
                            
                            -- Штраф за дальность обхода
                            score = score - sideDist * 0.5
                            
                            table.insert(bypassOptions, {
                                position = floorPos,
                                distance = sideDist,
                                side = sideData.name,
                                score = score,
                                hasWallAhead = forwardWall ~= nil
                            })
                        end
                    end
                end
            end
        end
    end
    
    -- Сортируем по score (лучшие первые)
    table.sort(bypassOptions, function(a, b)
        return a.score > b.score
    end)
    
    -- Возвращаем лучший вариант
    if #bypassOptions > 0 then
        return bypassOptions[1]
    end
    
    return nil
end

-- НОВОЕ: Попытка обойти препятствие
function Movement.TryBypass(targetPos)
    if not Movement.RootPart then return false end
    
    local dirToTarget = (targetPos - Movement.RootPart.Position)
    local horizontalDir = Vector3.new(dirToTarget.X, 0, dirToTarget.Z)
    if horizontalDir.Magnitude < 0.1 then return false end
    horizontalDir = horizontalDir.Unit
    
    -- Ищем обход
    local bypass = findWallBypass(Movement.RootPart.Position, horizontalDir, targetPos)
    
    if bypass then
        Movement.Log(string.format("↪️ Обхожу %s (%.1fм)", bypass.side == "left" and "слева" or "справа", bypass.distance))
        
        -- Идём к боковой точке
        Movement.Humanoid:MoveTo(bypass.position)
        
        local startTime = tick()
        local lastPos = Movement.RootPart.Position
        
        while tick() - startTime < 4 do
            if not Movement.IsActive() or Movement.Humanoid.Health <= 0 then
                return false
            end
            
            local dist = (bypass.position - Movement.RootPart.Position).Magnitude
            if dist < 2 then
                Movement.Log("✓ Обход успешен")
                return true
            end
            
            -- Проверяем застревание
            local moved = (Movement.RootPart.Position - lastPos).Magnitude
            if moved < 0.1 then
                -- Застряли при обходе — может нужен прыжок
                if Movement.IsOnGround() then
                    Movement.Humanoid.Jump = true
                    task.wait(0.3)
                end
            end
            lastPos = Movement.RootPart.Position
            
            Movement.Humanoid:MoveTo(bypass.position)
            task.wait(0.1)
        end
        
        -- Проверяем частичный успех
        local finalDist = (bypass.position - Movement.RootPart.Position).Magnitude
        return finalDist < 5
    end
    
    return false
end

function Movement.ExecuteJump(startNode, landNode)
    if not Movement.Humanoid or not Movement.RootPart then return false end
    
    local startPos = startNode.position
    local landPos = landNode.position
    
    Movement.Log(string.format("🦘 %s", startNode.description or "Прыжок"))
    
    -- Фаза 1: Подходим к точке старта
    local distToStart = (startPos - Movement.RootPart.Position).Magnitude
    
    if distToStart > 3 then
        Movement.Humanoid:MoveTo(startPos)
        
        local approachStart = tick()
        local lastPos = Movement.RootPart.Position
        local stuckTime = 0
        
        while tick() - approachStart < 2.5 do
            if not Movement.IsActive() or Movement.Humanoid.Health <= 0 then return false end
            
            distToStart = (startPos - Movement.RootPart.Position).Magnitude
            if distToStart < 2 then break end
            
            local moved = (Movement.RootPart.Position - lastPos).Magnitude
            if moved < 0.15 then
                stuckTime = stuckTime + 0.1
                if stuckTime > 0.4 then
                    break
                end
            else
                stuckTime = 0
            end
            lastPos = Movement.RootPart.Position
            
            Movement.Humanoid:MoveTo(startPos)
            task.wait(0.1)
        end
    end
    
    -- Фаза 2: Разбег к цели
    Movement.Log("🏃 Разбег...")
    Movement.Humanoid:MoveTo(landPos)
    
    local moveStart = tick()
    while tick() - moveStart < 0.3 do
        task.wait(0.05)
        local vel = Movement.RootPart.AssemblyLinearVelocity
        local speed = Vector2.new(vel.X, vel.Z).Magnitude
        if speed > 5 then break end
    end
    
    -- Фаза 3: Прыжок
    Movement.Log("🦘 Прыжок!")
    
    local startY = Movement.RootPart.Position.Y
    local jumped = Movement.ForceJump(landPos)
    
    if not jumped then
        Movement.Log("⚠️ Прыжок не удался, пробую ещё...")
        task.wait(0.2)
        jumped = Movement.ForceJump(landPos)
    end
    
    -- Фаза 4: Полёт
    local flightStart = tick()
    local maxFlightTime = 3
    local reachedPeak = false
    
    while tick() - flightStart < maxFlightTime do
        if not Movement.IsActive() or Movement.Humanoid.Health <= 0 then return false end
        
        Movement.Humanoid:MoveTo(landPos)
        
        local currentY = Movement.RootPart.Position.Y
        
        if currentY > startY + 2 then
            reachedPeak = true
        end
        
        if reachedPeak or tick() - flightStart > 0.3 then
            if Movement.IsOnGround() then
                break
            end
        end
        
        task.wait(0.05)
    end
    
    task.wait(0.15)
    
    local horizontalDist = Vector2.new(
        landPos.X - Movement.RootPart.Position.X,
        landPos.Z - Movement.RootPart.Position.Z
    ).Magnitude
    
    local success = horizontalDist < 10
    
    if success then
        Movement.Log("✓ Прыжок успешен")
        if Movement.Memory then
            Movement.Memory.AddSafeZone(Movement.RootPart.Position)
        end
    else
        Movement.Log(string.format("✗ Не долетел (%.1fм)", horizontalDist))
    end
    
    return success
end

function Movement.ExecuteWalk(node)
    if not Movement.Humanoid or not Movement.RootPart then return false end
    
    local targetPos = node.position
    
    Movement.Log(string.format("🚶 %s", node.description or "Иду"))
    
    Movement.Humanoid:MoveTo(targetPos)
    
    local startTime = tick()
    local lastPos = Movement.RootPart.Position
    local stuckTime = 0
    local lastJumpTime = 0
    local jumpCooldown = 0.5
    local bypassAttempted = false
    
    while tick() - startTime < 10 do
        if not Movement.IsActive() or Movement.Humanoid.Health <= 0 then return false end
        
        local diff = targetPos - Movement.RootPart.Position
        local horizontalDist = Vector2.new(diff.X, diff.Z).Magnitude
        
        -- Достигли цели
        if horizontalDist < 2.5 then
            if Movement.Memory then
                Movement.Memory.AddSafeZone(Movement.RootPart.Position)
            end
            return true
        end
        
        local horizontalDir = Vector3.new(diff.X, 0, diff.Z)
        if horizontalDir.Magnitude > 0.1 then
            horizontalDir = horizontalDir.Unit
        end
        
        local canJump = (tick() - lastJumpTime) > jumpCooldown and Movement.IsOnGround()
        
        -- Проверяем стену впереди
        local wall = checkWallAhead(Movement.RootPart.Position, horizontalDir, 2.5)
        
        if wall and wall.distance < 2.0 and wall.height > 0.5 then
            -- НОВОЕ: Сначала пробуем обойти, потом прыгать
            if wall.height <= 7.5 then
                -- Стена невысокая — сначала пробуем обход
                if not bypassAttempted then
                    Movement.Log(string.format("🧱 Стена %.1fм — ищу обход...", wall.height))
                    
                    local bypassed = Movement.TryBypass(targetPos)
                    bypassAttempted = true
                    
                    if bypassed then
                        -- Обход удался — продолжаем к цели
                        stuckTime = 0
                        lastPos = Movement.RootPart.Position
                        Movement.Humanoid:MoveTo(targetPos)
                        continue
                    else
                        -- Обход не удался — прыгаем
                        Movement.Log("❌ Обход не найден, прыгаю...")
                    end
                end
                
                -- Прыгаем
                if canJump then
                    Movement.Log(string.format("🦘 Прыгаю через стену (%.1fм)", wall.height))
                    
                    Movement.Humanoid:MoveTo(targetPos)
                    task.wait(0.1)
                    Movement.ForceJump(targetPos)
                    lastJumpTime = tick()
                    
                    Movement.WaitForLanding(2)
                    stuckTime = 0
                    lastPos = Movement.RootPart.Position
                    bypassAttempted = false  -- Сброс для следующей стены
                    
                    continue
                end
            else
                -- Стена слишком высокая — только обход
                Movement.Log(string.format("🧱 Стена слишком высокая (%.1fм) — ищу обход", wall.height))
                
                local bypassed = Movement.TryBypass(targetPos)
                
                if bypassed then
                    stuckTime = 0
                    lastPos = Movement.RootPart.Position
                    Movement.Humanoid:MoveTo(targetPos)
                    continue
                else
                    Movement.Log("❌ Не могу обойти высокую стену")
                    return false
                end
            end
        else
            bypassAttempted = false  -- Сброс когда нет стены
        end
        
        -- Проверка застревания
        local moved = (Movement.RootPart.Position - lastPos).Magnitude
        
        if moved < 0.2 then
            stuckTime = stuckTime + 0.1
            
            if stuckTime > 0.3 and canJump then
                local nearWall = checkWallAhead(Movement.RootPart.Position, horizontalDir, 1.5)
                
                if nearWall then
                    -- Есть стена — пробуем обойти
                    if not bypassAttempted then
                        Movement.Log("🔄 Застрял у стены — пробую обход")
                        
                        local bypassed = Movement.TryBypass(targetPos)
                        bypassAttempted = true
                        
                        if bypassed then
                            stuckTime = 0
                            lastPos = Movement.RootPart.Position
                            continue
                        end
                    end
                    
                    -- Обход не удался — прыгаем
                    Movement.Log(string.format("🦘 Прыгаю (застрял у стены %.1fм)", nearWall.height))
                else
                    Movement.Log("🦘 Прыгаю (застрял)")
                end
                
                Movement.Humanoid:MoveTo(targetPos)
                task.wait(0.05)
                Movement.ForceJump(targetPos)
                lastJumpTime = tick()
                
                Movement.WaitForLanding(2)
                stuckTime = 0
                lastPos = Movement.RootPart.Position
                bypassAttempted = false
                
                continue
            end
        else
            stuckTime = 0
            lastPos = Movement.RootPart.Position
        end
        
        Movement.Humanoid:MoveTo(targetPos)
        task.wait(0.1)
    end
    
    local finalDist = (targetPos - Movement.RootPart.Position).Magnitude
    return finalDist < 5
end

function Movement.ExecutePath(path, onProgress)
    local i = 1
    
    while i <= #path do
        if not Movement.IsActive() then return false, i end
        if not Movement.Humanoid or Movement.Humanoid.Health <= 0 then return false, i end
        
        local node = path[i]
        
        if onProgress then
            onProgress(i, #path)
        end
        
        local success = false
        
        if node.type == "jump_start" and i < #path then
            local landNode = path[i + 1]
            success = Movement.ExecuteJump(node, landNode)
            
            if success then
                i = i + 2
            else
                Movement.Log("⚠️ Повторяю прыжок...")
                task.wait(0.5)
                success = Movement.ExecuteJump(node, landNode)
                
                if success then
                    i = i + 2
                else
                    return false, i
                end
            end
        elseif node.type == "jump_land" then
            i = i + 1
        else
            success = Movement.ExecuteWalk(node)
            
            if success then
                i = i + 1
            else
                return false, i
            end
        end
    end
    
    return true, #path
end

print("[ObbyBot] Movement v" .. Movement.VERSION .. " loaded")

return Movement
